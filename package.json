{
  "name": "pulse",
  "version": "1.0.0",
  "description": "Student feedback and improvement tracking",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "\u003e=24"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "node scripts/env.mjs pnpm turbo dev --env-mode=loose",
    "start": "node scripts/env.mjs pnpm turbo start --env-mode=loose",
    "legacy:start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "typecheck": "turbo typecheck",
    "lint": "eslint apps packages",
    "format": "prettier --write apps packages",
    "e2e": "playwright test",
    "test:acceptance": "node scripts/acceptance.mjs",
    "db:migrate": "node scripts/env.mjs pnpm --filter @pulse/api db:migrate",
    "db:seed": "node scripts/env.mjs pnpm --filter @pulse/api db:seed",
    "db:backup": "node scripts/backup-postgres.mjs",
    "backup": "node src/backup.js"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^24.10.0",
    "@playwright/test": "^1.56.1",
    "turbo": "^2.6.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.6.2"
  },
  "private": true
}
